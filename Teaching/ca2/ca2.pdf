endobj
8920 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 294 >>        
stream
\begin {align*}\ker \left (\HH _i(x_1, \ldots , x_n; M) \xrightarrow {\,\, \varphi \,\,} \HH _i(x_1, \ldots , x_{n+1}; M) \right ) \\ = \im (\HH _i(x_1, \ldots , x_n; M) \xrightarrow { \,\, x_{n+1} \,\,} \HH _i(x_1, \ldots , x_n;M)) \\ = x_{n+1} \cdot \HH _i(x_1, \ldots , x_n; M).\end {align*}
endstream
endobj
