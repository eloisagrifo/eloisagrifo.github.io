8937 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 679 >>        
stream
\begin {equation*}\begin {aligned} \coker (\overline {\varphi }) & = \displaystyle \frac {\HH _i(x_1, \ldots , x_{n+1}; M)}{\im (\varphi )} & \text {by definition} \\ & = \displaystyle \frac {\HH _i(x_1, \ldots , x_{n+1}; M)}{\ker (\psi )} & \text {by exactness} \\ & \cong \im (\psi ) & \text {by the First Iso Theorem}\\ & = \im \left (\HH _i(x_1, \ldots , x_{n+1}; M) \xrightarrow {\,\, \psi \,\,} \HH _{i-1}(x_1, \ldots , x_n; M) \right ) \\ & = \ker \left ( \HH _{i-1}(x_1, \ldots , x_n; M) \xrightarrow {\, x_{n+1} \,} \HH _{n-1}(x_1, \ldots , x_n; M) \right ) & \text {by exactness} \\ & = \ann _{\HH _{i-1}(x_1, \ldots , x_n; M)} (x_{n+1}). \end {aligned}\end {equation*}
endstream
endobj
