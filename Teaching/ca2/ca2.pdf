stream
\begin {equation*}\begin {aligned} \HH _n(\underline {x};M) & = \ker \left ( M \xrightarrow {\,\begin {pmatrix} x_1 & - x_2 & x_3 & \cdots & (-1)^{n+1} x_n \end {pmatrix}^T} M^n \right ) \\ & = \left \lbrace m \in M \mid rx_1 = rx_2 = \cdots = rx_n = 0 \right \rbrace \\ & = (0:_M I ). \end {aligned}\end {equation*}
endstream
endobj
