22781 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 337 >>        
stream
\begin {equation*}\begin {aligned} \dim _k \left ( \Ext ^i_R(k,M) \right ) & \text {by \Cref {depth homological def}} \\ & = \dim _k \left ( \Ext ^i_R(k,M)\otimes _R \widehat {R} \right ) \\ & = \dim _k \left ( \Ext ^i_{\widehat {R}}(k,\widehat {M}) \right ) & \text {by \Cref {completion of Ext and Tor}.} \end {aligned}\end {equation*}
endstream
endobj
22782 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile3668.tex) /UF <FEFF007400610067002D0041004600660069006C00650033003600360038002E007400650078> /EF<</F 22781 0 R/UF 22781 0 R>> >>
endobj
22791 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 202 >>        
stream
\begin {equation*}\depth _{\m }(M) = \min \{ i \mid \Ext _R^i(k,M) \neq 0 \} = \min \{ i \mid \Ext ^i_{\widehat {R}} (k,\widehat {M}) \neq 0 \} = \depth _{\widehat {\m }} (\widehat {M}).\end {equation*}
endstream
endobj
22792 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile3669.tex) /UF <FEFF007400610067002D0041004600660069006C00650033003600360039002E007400650078> /EF<</F 22791 0 R/UF 22791 0 R>> >>
endobj
22796 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 434 >>        
stream
\begin {equation*}\begin {aligned} \mu _R(M) & = \dim _k (M/mM) & \text {by NAK}\\ & = \dim _k \left ( \widehat {M/mM} \right ) \\ & = \dim _k \left ( \widehat {M}/\widehat {mM} \right ) & \text {by \Cref {completion of ideal}}\\ & = \dim _k \left ( \widehat {M}/\widehat {m}\widehat {M} \right ) & \text {by \Cref {completion of ideal}}\\ & = \mu _{\widehat {R}}(\widehat {M}) & \text {by NAK.}\qedhere \end {aligned}\end {equation*}
endstream
endobj
