\begin {equation*}\kos (f,g) = \text {Totalization of} \!\!\! \begin {tikzcd}[column sep = 4mm, row sep = 5mm] \&\&\& 0 \arrow [dd] \&\&\& 0 \arrow [dd] \&\& \\ \&\&\& \phantom {0} \&\& \phantom {0} \& \phantom {0} \& \phantom {0} \&\&\\ \& 0 \arrow [rr] \&\& R \arrow [rrr, "-g"] \arrow [dd, "f" left] \&\&\& R \arrow [rr] \arrow [dd, "f"] \&\& 0 \\ \&\&\&\&\& \& \phantom {0}\& \phantom {0}\& \& \\ \& 0 \arrow [rr] \&\& R \arrow [rrr, "g" below] \arrow [dd] \&\&\& R \arrow [rr] \arrow [dd] \&\& 0 \\ \text {\color {teal} \tiny {2}} \arrow [uuuuurrrrrr, dash, dotted, teal] \&\&\&\&\& \\ \& \text {\color {teal} \tiny {1}} \arrow [uuuuurrrrrr, dash, dotted, teal] \&\& 0 \&\&\& 0 \&\& \\ \&\&\text {\color {teal} \tiny {0}} \arrow [uuuurrrrr, dash, dotted, teal] \&\&\&\&\& \end {tikzcd}\end {equation*}
endstream
endobj
