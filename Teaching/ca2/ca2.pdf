8916 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 252 >>        
stream
\begin {equation*}\HH _i(x_1, \ldots , x_n; M) \xrightarrow {\,\, x_{n+1}\,\,} \HH _i(x_1, \ldots , x_n; M) \xrightarrow {\,\, \varphi \,\,} \HH _i(x_1, \ldots , x_{n+1};M) \xrightarrow {\,\, \psi \,\,} \HH _{i-1}(x_1, \ldots , x_n; M).\end {equation*}
endstream
endobj
