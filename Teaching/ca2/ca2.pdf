\begin {equation*}\HH _0(\underline {x};M) = \coker \left ( M \xrightarrow {\, \begin {pmatrix} x_1 & x_2 & x_3 & \cdots & x_n \end {pmatrix}\,} M \right ) = M/IM.\end {equation*}
endstream
endobj
