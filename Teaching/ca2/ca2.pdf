22736 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 447 >>        
stream
\begin {equation*}\begin {aligned} \beta _i^R(M) & = \dim _k \left ( \Tor _i^R(k,M) \right ) & \text {by \Cref {exercise Betti Tor Ext}} \\ & = \dim _k \left ( \Tor _i^R(k,M) \otimes _R \widehat {R} \right ) & \\ & = \dim _k \left ( \Tor _i^{\widehat {R}}(k,\widehat {M}) \right ) & \text {by \Cref {completion of Ext and Tor}}\\ & = \beta _i^{\widehat {R}}(\widehat {M}) & \text {by \Cref {exercise Betti Tor Ext}.} \end {aligned}\end {equation*}
endstream
endobj
