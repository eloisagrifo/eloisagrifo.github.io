stream
\begin {align*}\varprojlim M/M_n&= \{ \{ m_n+M_n \} \in \prod _{n\geqslant 0} M/M_n \mid \pi _n(m_n+M_n)=m_{n-1}+M_{n-1} \text { for all } n\} \\ &=\{ \{ m_n+M_n \} \in \prod _{n\geqslant 0} M/M_n\mid m_n-m_{n-1}\in M_{n-1} \text { for all } n\}.\end {align*}
endstream
endobj
