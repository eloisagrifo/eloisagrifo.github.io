<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile3665.tex) /UF <FEFF007400610067002D0041004600660069006C00650033003600360035002E007400650078> /EF<</F 22736 0 R/UF 22736 0 R>> >>
endobj
22746 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 191 >>        
stream
\begin {equation*}\pdim _R(M) = \sup \{ i \mid \beta _i^R(M) \neq 0 \} = \sup \{ i \mid \beta _i^{\widehat {R}}(\widehat {M}) \neq 0 \} = \pdim _{\widehat {R}} (\widehat {M}).\end {equation*}
endstream
endobj
