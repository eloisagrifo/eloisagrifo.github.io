\begin {equation*}\frac {\HH _i(x_1, \ldots , x_n; M)}{x_{n+1} \cdot \HH _i (x_1, \ldots , x_n; M)} \lhook \joinrel \xrightarrow {\,\,\, \overline {\varphi } \,\,\,} \HH _i (x_1, \ldots , x_{n+1} ; M)\end {equation*}
endstream
endobj
