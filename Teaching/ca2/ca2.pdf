8694 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 405 >>        
stream
\begin {equation*}\begin {aligned} s_a \partial \left ( e_{i_1} \wedge \cdots \wedge e_{i_t} \right ) & = s_a \left ( \sum _{k=1}^t (-1)^{k+1} x_k e_{i_1} \wedge \cdots \wedge \widehat {e_{j_k}} \wedge \cdots \wedge e_{i_t} \right ) \\ & = \sum _{j=1}^n \sum _{k=1}^t (-1)^{k+1} a_j x_k e_j \wedge e_{i_1} \wedge \cdots \wedge \widehat {e_{j_k}} \wedge \cdots \wedge e_{i_t} \end {aligned}\end {equation*}
endstream
endobj
