endobj
8698 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260910) >> /Length 555 >>        
stream
\begin {equation*}\begin {aligned} \partial s_a \left ( e_{i_1} \wedge \cdots \wedge e_{i_t} \right ) & = \partial \left ( \sum _{j=1}^n a_j e_j \wedge e_{i_1} \wedge \cdots \wedge e_{i_t}\right )\\ & = \sum _{j=1}^n \sum _{k=1}^t (-1)^{k+2} a_j e_j \wedge e_{j_1} \wedge \cdots \wedge \widehat {e_{i_k}} \wedge \cdots \wedge e_{i_s} + \sum _{j=1}^n a_j x_j e_{i_1} \wedge \cdots \wedge e_{i_t} \\ & = - s_a d \left ( e_{i_1} \wedge \cdots \wedge e_{i_t} \right ) + \sum _{j=1}^n a_j x_j e_{i_1} \wedge \cdots \wedge e_{i_t} \end {aligned}\end {equation*}
endstream
endobj
