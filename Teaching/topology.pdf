stream
\begin {equation*}\begin {aligned} U \text { is open in } Y & \iff p^{-1}(U) \text { is open in } X & \text {since $p$ is a quotient map} \\ & q(p^{-1}(U)) \text { is open in } X/\sim & \text {by definition of the quotient topology on } X / \sim \\ & g(U) \text { is open in } Y.\qedhere \end {aligned}\end {equation*}
endstream
endobj
