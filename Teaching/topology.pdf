stream
\begin {equation*}\left ( x_{\alpha } \right )_{\alpha \in I} \in P(\beta , U_{\beta }) = \prod _{\alpha \in I} A_{\alpha } \qquad \text {where } A_{\alpha } = \begin {cases} U_\beta & \text {if } \alpha =\beta \\ X_{\alpha } & \text {if } \alpha \neq \beta . \end {cases}\end {equation*}
endstream
endobj
