stream
\begin {equation*}\left \lbrace \prod _{\alpha \in I} U_{\alpha } \mid U_{\alpha } \in T_{\alpha } \text { with } U_{\alpha } = X_{\alpha } \text { for all but finitely many } \alpha \in I \right \rbrace \end {equation*}
endstream
endobj
