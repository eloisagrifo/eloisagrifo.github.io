\begin {equation*}s \in f^{-1}(U_{\alpha }) \iff f(s) = (f_\alpha (s))_{\alpha \in I} \in U \iff f_{\alpha }(s) \in U_{\alpha } \text { for all } \alpha \in I.\end {equation*}
endstream
endobj
