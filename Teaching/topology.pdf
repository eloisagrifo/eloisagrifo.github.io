\begin {equation*}\begin {aligned} f(\overline {f^{-1}(C)}) & \subseteq \overline {f(f^{-1}(C)} & \text {by \ref {char continuous 4}}\\ & \subseteq \overline {C} & \text {applying \Cref {containment preserved by closure} to } f(f^{-1}(C) \subseteq C \text { from \Cref {properties of preimages}}\\ & = C & \text {since $C$ is closed}. \end {aligned}\end {equation*}
endstream
