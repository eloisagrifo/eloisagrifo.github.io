15315 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261024) >> /Length 328 >>        
stream
\begin {equation*}\begin {aligned} U \text { is open in } Y & \iff p^{-1}(U) \text { is open in } X & \text {since $p$ is a quotient map} \\ & \iff q(p^{-1}(U)) \text { is open in } X/\sim & \text {by definition of the quotient topology} \\ & \iff g(U) \text { is open in } X/\sim .\hfill \qedhere \end {aligned}\end {equation*}
endstream
endobj
