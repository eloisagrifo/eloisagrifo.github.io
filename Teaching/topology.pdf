\begin {equation*}\begin {aligned} x \in X \setminus \overline {S} & \iff x \notin \overline {S} \\ & \iff \text {there is an open neighborhood } U \text { of } x \text { with } U \cap S = \emptyset & \text {by \Cref {characterization of closure and interior}} \\ & \iff \text {there is an open neighborhood } U \text { of } x \text { with } U \subseteq X \setminus S \\ & \iff x \in (X \setminus S)\inte & \text {by \Cref {characterization of closure and interior}.}\qedhere \end {aligned}\end {equation*}
endstream
endobj
