stream
\begin {equation*}A \setminus \left ( \bigcup _{\alpha \in \Lambda } B_{\alpha } \right ) = \bigcap _{\alpha \in \Lambda } (A \setminus B_{\alpha }) \quad \text {and} \quad A \setminus \left ( \bigcap _{\alpha } B_{\alpha } \right ) = \bigcup _{\alpha \in \Lambda } (A \setminus B_{\alpha }).\end {equation*}
endstream
