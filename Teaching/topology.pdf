stream
\begin {equation*}\overline {d}(x_{\alpha }, y_{\alpha }) < \frac {\e }{2} < 1 \implies d(x_{\alpha }, y_{\alpha }) = \overline {d}(x_{\alpha }, y_{\alpha }) < \frac {\e }{2}\end {equation*}
