13354 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261114) >> /Length 168 >>        
stream
\begin {equation*}U = \prod _{\alpha \in I} U_{\alpha } \qquad \text {with } U_{\alpha } = X_{\alpha } \text { for all but finitely many } \alpha \in I.\end {equation*}
endstream
endobj
13355 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2182.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003100380032002E007400650078> /EF<</F 13354 0 R/UF 13354 0 R>> >>
endobj
13358 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261114) >> /Length 129 >>        
stream
\begin {equation*}\{ \alpha \in I \mid U_{\alpha } \neq X_{\alpha } \} = \{ \alpha _1, \ldots , \alpha _n\} =: J.\end {equation*}
endstream
endobj
13359 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2183.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003100380033002E007400650078> /EF<</F 13358 0 R/UF 13358 0 R>> >>
endobj
13362 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261114) >> /Length 175 >>        
stream
\begin {equation*}s \in f^{-1}(U_{\alpha }) \iff f(s) = (f_\alpha (s))_{\alpha \in I} \in U \iff f_{\alpha }(s) \in U_{\alpha } \text { for all } \alpha \in I.\end {equation*}
endstream
endobj
