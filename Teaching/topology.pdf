\begin {equation*}\begin {aligned} d(f(z),f(x)) & \leqslant d(f(z),f_N(z)) + d(f_N(z), f(x)) \\ & \leqslant d(f(z),f_N(z)) + d(f_N(z), f_N(x)) + d(f_N(x), f(x)) \\ & < \frac {\e }{3} + \frac {\e }{3} + \frac {\e }{3} \\ & = \e . \end {aligned}\end {equation*}
endstream
