stream
\begin {equation*}P(\beta _1, U_{\beta _1}) \cap \cdots \cap P(\beta _n, U_{\beta _n}) = \prod _{\alpha \in I} B_{\alpha } \quad \text {with } B_\alpha = \begin {cases} U_{\beta _1} & \text {if } \alpha =\beta _1 \\ \,\, \vdots \\ U_{\beta _n} & \text {if } \alpha =\beta _n \\ X_{\alpha } & \text {if } \alpha \notin \{ \beta _1, \ldots , \beta _n \}. \end {cases}\end {equation*}
endstream
endobj
