15848 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261104) >> /Length 133 >>        
stream
\begin {equation*}q(p^{-1}(U)) \text { is open in } X/\sim \text { if and only if } p^{-1}(U) \text { is open in } X.\end {equation*}
endstream
endobj
15849 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2858.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003800350038002E007400650078> /EF<</F 15848 0 R/UF 15848 0 R>> >>
endobj
15852 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261104) >> /Length 263 >>        
stream
\begin {equation*}\begin {aligned} U \text { is open in } Y & \iff p^{-1}(U) \text { is open in } X & \text {since $p$ is a quotient map} \\ & \iff p(p^{-1}(U)) \text { is open in } X/\sim \\ & \iff g(U) \text { is open in } X/\sim .\end {aligned}\end {equation*}
endstream
endobj
