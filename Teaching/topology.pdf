<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261115) >> /Length 115 >>        
stream
\begin {equation*}g(U) = \{ [x] \mid p(x) \in U \} = \{ [x] \mid x \in p^{-1}(U) \} = q(p^{-1}(U)).\end {equation*}
endstream
endobj
