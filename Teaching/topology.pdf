stream
\begin {equation*}\{ \alpha \in I \mid U_{\alpha } \neq X_{\alpha } \} = \{ \alpha _1, \ldots , \alpha _n\} =: J.\end {equation*}
endstream
endobj
13778 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2182.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003100380032002E007400650078> /EF<</F 13777 0 R/UF 13777 0 R>> >>
