   <pdfd:declarations>
    <rdf:Bag>
     <rdf:li rdf:parseType="Resource">
      <pdfd:conformsTo>http://pdfa.org/declarations/wtpdf#accessibility1.0</pdfd:conformsTo>
      <pdfd:claimData>
       <rdf:Bag>
