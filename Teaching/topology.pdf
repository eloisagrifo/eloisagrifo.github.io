<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261120) >> /Length 168 >>        
stream
\begin {equation*}U = \prod _{\alpha \in I} U_{\alpha } \qquad \text {with } U_{\alpha } = X_{\alpha } \text { for all but finitely many } \alpha \in I.\end {equation*}
endstream
endobj
13774 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2181.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003100380031002E007400650078> /EF<</F 13773 0 R/UF 13773 0 R>> >>
