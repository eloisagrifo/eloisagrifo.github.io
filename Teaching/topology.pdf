13085 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261106) >> /Length 129 >>        
stream
\begin {equation*}\{ \alpha \in I \mid U_{\alpha } \neq X_{\alpha } \} = \{ \alpha _1, \ldots , \alpha _n\} =: J.\end {equation*}
endstream
endobj
13086 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2177.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003100370037002E007400650078> /EF<</F 13085 0 R/UF 13085 0 R>> >>
endobj
13089 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261106) >> /Length 175 >>        
stream
\begin {equation*}s \in f^{-1}(U_{\alpha }) \iff f(s) = (f_\alpha (s))_{\alpha \in I} \in U \iff f_{\alpha }(s) \in U_{\alpha } \text { for all } \alpha \in I.\end {equation*}
endstream
endobj
