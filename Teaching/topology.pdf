16636 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261118) >> /Length 133 >>        
stream
\begin {equation*}q(p^{-1}(U)) \text { is open in } X/\sim \text { if and only if } p^{-1}(U) \text { is open in } X.\end {equation*}
endstream
endobj
16637 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2863.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003800360033002E007400650078> /EF<</F 16636 0 R/UF 16636 0 R>> >>
endobj
16640 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261118) >> /Length 263 >>        
stream
\begin {equation*}\begin {aligned} U \text { is open in } Y & \iff p^{-1}(U) \text { is open in } X & \text {since $p$ is a quotient map} \\ & \iff p(p^{-1}(U)) \text { is open in } X/\sim \\ & \iff g(U) \text { is open in } X/\sim .\end {aligned}\end {equation*}
endstream
endobj
