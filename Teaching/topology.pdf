<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20261023) >> /Length 246 >>        
stream
\begin {equation*}\pi _\beta ^{-1}( U_\beta ) = \prod _{\alpha \in I} A_{\alpha } \qquad \text {where } A_{\alpha } = \begin {cases} U_\beta & \text {if } \alpha =\beta \\ X_{\alpha } & \text {if } \alpha \neq \beta . \end {cases}\end {equation*}
endstream
