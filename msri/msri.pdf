15915 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260806) >> /Length 295 >>        
stream
\begin {align*}(u\otimes v\otimes w)^{\rm anti} = \ & u\otimes v\otimes w + (-1)^{|w|(|u|+|v|)} w\otimes u\otimes v + (-1)^{|u|(|v|+|w|)} v\otimes w\otimes u \\ &-(-1)^{|u||v|}v\otimes u\otimes w - (-1)^{|v||w|} u\otimes w\otimes v - (-1)^{|u||v|+|u||v|+|v||w|} w\otimes v\otimes u.\end {align*}
endstream
endobj
15916 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2385.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003300380035002E007400650078> /EF<</F 15915 0 R/UF 15915 0 R>> >>
endobj
15919 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260806) >> /Length 111 >>        
stream
\begin {equation*}(u\otimes v)^{\rm anti}= [u,v]^\otimes = u\otimes v- (-1)^{|u||v|}v\otimes u.\end {equation*}
endstream
endobj
15920 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2386.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003300380036002E007400650078> /EF<</F 15919 0 R/UF 15919 0 R>> >>
