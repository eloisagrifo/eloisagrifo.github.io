23378 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 421 >>        
stream
\begin {equation*}\begin {aligned} \begin {bmatrix} x^2 \\ 0 \end {bmatrix} & = x^2 \begin {bmatrix} 1 \\ 0 \end {bmatrix} \\ & = \left ( \sigma _1 \partial + \partial \sigma _1 \right ) \left ( \begin {bmatrix} 1 \\ 0 \end {bmatrix} \right ) \\ & = \begin {bmatrix} x^2 \\ 0 \end {bmatrix} + \begin {bmatrix} ay \\ -ax \end {bmatrix} \\ & = \begin {bmatrix} x^2 + ay \\ -ax \end {bmatrix}. \end {aligned}\end {equation*}
endstream
endobj
23379 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile4122.tex) /UF <FEFF007400610067002D0041004600660069006C00650034003100320032002E007400650078> /EF<</F 23378 0 R/UF 23378 0 R>> >>
endobj
23384 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 417 >>        
stream
\begin {equation*}\begin {aligned} \begin {bmatrix} 0 \\ x^2 \end {bmatrix} & = x^2 \begin {bmatrix} 0 \\ 1 \end {bmatrix} \\ & = \left ( \sigma _1 \partial + \partial \sigma _1 \right ) \left ( \begin {bmatrix} 0 \\ 1 \end {bmatrix} \right ) \\ & = \begin {bmatrix} xy \\ 0 \end {bmatrix} + \begin {bmatrix} by \\ -bx \end {bmatrix} \\ & = \begin {bmatrix} by+xy \\ -bx \end {bmatrix}. \end {aligned}\end {equation*}
endstream
endobj
