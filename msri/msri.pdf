\begin {equation*}\Sh (F,\sigma , E)_{\ell } := \displaystyle \bigoplus _{\substack {i_0+i_1+\cdots +i_n = d \\ d \geqslant 0}} E_{i_0} \otimes t_1^{(i_1)} \cdots t_n^{(i_n)} \otimes _Q F_{\ell -2d}\end {equation*}
endstream
endobj
