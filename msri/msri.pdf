\begin {equation*}\partial \sigma _i = \tau _i - \sigma _i \partial .\end {equation*}
endstream
endobj
23213 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile4063.tex) /UF <FEFF007400610067002D0041004600660069006C00650034003000360033002E007400650078> /EF<</F 23212 0 R/UF 23212 0 R>> >>
