endstream
endobj
23372 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile4121.tex) /UF <FEFF007400610067002D0041004600660069006C00650034003100320031002E007400650078> /EF<</F 23371 0 R/UF 23371 0 R>> >>
