\begin {equation*}\partial (a \otimes r + b \otimes s) = \partial (a) \otimes r + (-1)^{i-1} a \otimes (x_{n+1} r) + \partial (b) \otimes s + (-1)^{i} b \otimes 0,\end {equation*}
endstream
endobj
