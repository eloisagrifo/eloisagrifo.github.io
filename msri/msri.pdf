stream
\begin {equation*}\partial \left ( e \otimes t_1^{(i_1)} \cdots t_n^{(i_n)} \otimes u \right ) = \begin {array}{c} \displaystyle \sum _{\omega } e \otimes t_1^{(i_1- \omega _1)} \cdots t_n^{(i_n-\omega _n)} \otimes \sigma _{\omega } (u) \\ + \displaystyle \sum _{j=1}^n e \otimes t_1^{(i_1)} \cdots t_j^{(i_j-1)} \cdots t_n^{(i_n)} \otimes e_j u \\ + \partial _E(e) \otimes t_1^{(i_1)} \cdots t_n^{(i_n)} \otimes u. \end {array}\end {equation*}
endstream
endobj
