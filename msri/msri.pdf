\begin {equation*}\sum _{n=0}^\infty \dim _k ( k \langle y \rangle _n ) \cdot t^n = \sum _{\ell =0}^\infty t^{(2i) \ell } = \frac {1}{1-t^{2i}}.\end {equation*}
endstream
