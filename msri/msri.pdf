\begin {equation*}\begin {tikzcd}[column sep = 2.5 em, row sep = 1.7 em] 0 \arrow [r] \& Q \arrow [rr, "{\begin {bmatrix} y \\ -x \end {bmatrix}}"] \&\& Q^2 \arrow [rr, "{\begin {bmatrix} x^2 & xy \end {bmatrix}}"] \arrow [ddll, "{\begin {bmatrix} 0 & -x \end {bmatrix}}" description] \&\& Q \arrow [ddll, "{\begin {bmatrix} 1 \\ 0 \end {bmatrix}}" description] \arrow [r] \& 0 \\ \\ 0 \arrow [r] \& Q \arrow [rr] \&\& Q^2 \arrow [rr] \&\& Q \arrow [r] \& 0 \end {tikzcd}\end {equation*}
