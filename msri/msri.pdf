8900 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 907 >>        
stream
\begin {equation*}\begin {aligned} \partial \circ \widetilde {\varphi } (ax^i) & = \partial (\varphi (a) b^i) \\ & = \partial (\varphi (a)) b^i + (-1)^{|a|}\varphi (a) \partial (b^i) & \text {by the Leibniz rule} \\ & = \varphi (\partial (a)) b^i + (-1)^{|a|}\varphi (a) \partial (b^i) & \text {since } \varphi \partial = \partial \varphi \\ & = \varphi (\partial (a)) b^i + (-1)^{|a|} i \varphi (a) \partial (b) b^{i-1} & \text {by \Cref {differential of power}} \\ & = \varphi (\partial (a)) \varphi (x^i) + (-1)^{|a|} i \varphi (a) \varphi (\partial (x)) \widetilde {\varphi } (x^{i-1}) & \text {since } \varphi (\partial (x)) = \varphi (z) = \partial (b) \\ & = \widetilde {\varphi } \left ( \partial (a)x^i + (-1)^{|a|} i az \varphi (\partial (x)) x^{i-1} \right ) \\ & = \widetilde {\varphi } \left ( \partial (a x^i) \right ) & \text {by \Cref {differential of power}}. \end {aligned}\end {equation*}
endstream
endobj
