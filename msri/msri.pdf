\begin {equation*}P_k^R(t) = \frac {\, \displaystyle \prod _{i=1}^\infty (1+t^{2i-1})^{|Y_{2i-1}|}}{\displaystyle \prod _{i=1}^\infty (1-t^{2i})^{|Y_{2i}|}} = \frac {\, \displaystyle \prod _{i=1}^\infty (1+t^{2i-1})^{\varepsilon _{2i-1}(R)}}{\displaystyle \prod _{i=1}^\infty (1-t^{2i})^{\varepsilon _{2i}(R)}}.\end {equation*}
endstream
