15927 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 1145 >>       
stream
\begin {align*}\langle \sum & (u_j\otimes v_j)^{\rm anti}\otimes w_j,\partial (x y)\rangle \\ &= \langle \sum (u_j\otimes v_j)^{\rm anti} \otimes w_j,\partial (x) y\rangle +(-1)^{|x|}\langle \sum (u_j\otimes v_j)^{\rm anti}\otimes w_j,x\partial (y)\rangle \\ &= \langle \sum (u_j\otimes v_j)^{\rm anti} \otimes w_j,\partial (x) y\rangle +(-1)^{|x|+|x|(|y|-1)}\langle \sum (u_j\otimes v_j)^{\rm anti}\otimes w_j,\partial (y)x\rangle \\ &= (-1)^{|x|-1}\sum \langle (u_j\otimes v_j)^{\rm anti},\partial (x)\rangle \langle w_j , y\rangle +(-1)^{|x|+|x|(|y|-1)+|y|-1} \sum \langle (u_j\otimes v_j)^{\rm anti},\partial (y)\rangle \langle w_j, x\rangle \\ & = (-1)^{|x|-1}\sum \langle [u_j, v_j],x\rangle \langle w_j , y\rangle +(-1)^{|x||y|+|y|-1} \sum \langle [u_j, v_j],y\rangle \langle w_j, x\rangle \\ & = (-1)^{|x|-1} \left [\sum \langle [u_j, v_j],x\rangle \langle w_j , y\rangle -(-1)^{(|y|+1)(|x|+1)} \sum \langle [u_j, v_j],y\rangle \langle w_j, x\rangle \right ] \\ & = -\langle \sum [u_j, v_j] \otimes w_j-(-1)^{(|y|+1)(|x|+1)}w_j \otimes [u_j, v_j],xy\rangle \\ & = -\langle \sum ([u_j, v_j] \otimes w_j)^{\rm anti},xy\rangle \end {align*}
endstream
endobj
