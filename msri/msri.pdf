endobj
15873 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 210 >>        
stream
\begin {equation*}\langle -, - \rangle \colon D_3^{\rm anti}(L)\otimes _k k[X]^3 \longrightarrow k,\quad \langle \sum u_i\otimes v_i\otimes w_i,x yz\rangle = \sum (-1)^{|y|} u_i(x) v_i(y) w_i(z)\end {equation*}
endstream
endobj
