23216 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260806) >> /Length 285 >>        
stream
\begin {equation*}\partial \sigma _i \sigma _{n-i} = \tau _i \sigma _{n-i} - \sigma _i \partial \sigma _{n-i} = \tau _i \sigma _{n-i} - \sigma _i (\tau _{n-i} - \sigma _{n-i} \partial ) = \tau _i \sigma _{n-i} - \sigma _i \tau _{n-i} + \sigma _i \sigma _{n-i} \partial \end {equation*}
endstream
endobj
23217 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile4064.tex) /UF <FEFF007400610067002D0041004600660069006C00650034003000360034002E007400650078> /EF<</F 23216 0 R/UF 23216 0 R>> >>
endobj
23220 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260806) >> /Length 327 >>        
stream
\begin {equation*}\partial \tau _n = - \sum _{i=1}^{n-1} \partial \sigma _i \sigma _{n-i} = \sum _{i=1}^{n-1} \left ( \sigma _i \tau _{n-i} - \tau _i \sigma _{n-i} - \sigma _i \sigma _{n-i} \partial \right ) = \sum _{i=1}^{n-1} \left ( \sigma _i \tau _{n-i} - \tau _i \sigma _{n-i} \right ) + \tau _n \partial .\end {equation*}
endstream
endobj
23221 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile4065.tex) /UF <FEFF007400610067002D0041004600660069006C00650034003000360035002E007400650078> /EF<</F 23220 0 R/UF 23220 0 R>> >>
endobj
23224 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260806) >> /Length 302 >>        
stream
\begin {equation*}\begin {aligned} \sum _{i=1}^{n-1} \left ( \sigma _i \tau _{n-i} - \tau _i \sigma _{n-i} \right ) & = - \sum _{i=1}^{n-1} \sum _{j=1}^{n-i-1} \sigma _i \sigma _j \sigma _{n-i-j} + \sum _{i=1}^{n-1} \sum _{j=1}^{i-1} \sigma _j \sigma _{i-j} \sigma _{n-i} \end {aligned}\end {equation*}
endstream
endobj
