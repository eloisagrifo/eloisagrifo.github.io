stream
\begin {equation*}\partial = \sum _{|\omega | \geqslant 0} (-1)^{|\omega |} \id _E \otimes \chi ^{\omega } \otimes \sigma _{\omega } + \sum _{i=1}^n e_i \otimes \chi _i \otimes 1 + \partial _E \otimes \id _{\Gamma } \otimes \id _F\end {equation*}
endstream
endobj
