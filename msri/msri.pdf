<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 241 >>        
stream
\begin {equation*}\begin {aligned} \mu (\HH _1(K^R)) & = \mu (I) & \text {by \Cref {1st Koszul homology min gens I}} \\ & \geqslant \height (I) & \text {by Krull's Height Theorem} \\ & = \embdim (R) - \dim (R). \end {aligned}\end {equation*}
endstream
endobj
