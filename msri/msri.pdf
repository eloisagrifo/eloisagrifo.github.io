15863 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 111 >>        
stream
\begin {equation*}(u\otimes v)^{\rm anti}= [u,v]^\otimes = u\otimes v- (-1)^{|u||v|}v\otimes u.\end {equation*}
endstream
endobj
15864 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile2386.tex) /UF <FEFF007400610067002D0041004600660069006C00650032003300380036002E007400650078> /EF<</F 15863 0 R/UF 15863 0 R>> >>
endobj
15867 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 232 >>        
stream
\begin {equation}\label {eq_antisym} (u\otimes v\otimes w)^{\rm anti} = (u\otimes v)^{\rm anti} \otimes w +(-1)^{|w|(|u|+|v|)} (w\otimes u)^{\rm anti}\otimes v + (-1)^{|u|(|v|+|w|)} ({v\otimes w})^{\rm anti}\otimes u.\end {equation}
endstream
endobj
