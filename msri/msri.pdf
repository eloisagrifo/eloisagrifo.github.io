21978 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 581 >>        
stream
\begin {equation*}\begin {aligned} \theta _z(x) & = - (-1)^{|z|} \frac {d}{dz} \partial _q(x) \\ & = - (-1)^{|z|} \frac {d}{dz} \left ( \sum _{\substack {u \leqslant v \in X \\ |u|+|v|+1 = |x|}} C_{x,u,v} uv \right ). \\ & = - (-1)^{|z|} \left ( \sum _{u < z} (-1)^{|u| \cdot |\frac {d}{dz}|} C_{x,u,z} u + \frac {d}{dz}( C_{x,z,z} z^2 ) + \sum _{z < v} c_{x,z,v} v \right ) & \text {by \Cref {ddz of z2}} \\ & = - (-1)^{|z|} \left ( \sum _{u < z} (-1)^{|u| \cdot |z|} C_{x,u,z} u + \frac {d}{dz}( C_{x,z,z} z^2 ) + \sum _{z < v} C_{x,z,v} v \right ) \end {aligned}\end {equation*}
endstream
endobj
21979 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile3782.tex) /UF <FEFF007400610067002D0041004600660069006C00650033003700380032002E007400650078> /EF<</F 21978 0 R/UF 21978 0 R>> >>
endobj
21986 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 181 >>        
stream
\begin {equation*}\frac {d}{dz}( C_{x,z,z} z^2 ) = \begin {cases} 0 & \text {if } |z| \text { is odd}\\ 2C_{x,z,z} z & \text {if } |z| \text { is even.} \end {cases}\end {equation*}
endstream
endobj
