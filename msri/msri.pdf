stream
\begin {equation*}(\theta _z)^{\vee }(y^{\vee }) = -(-1)^{|z|} \sum _{|y|+|z|+1 = |x|} C_{x,z,y} x^{\vee } = - [z^{\vee }, y^{\vee }].\end {equation*}
endstream
