25443 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 292 >>        
stream
\begin {equation*}\begin {aligned} \Hom _Q(\Gamma ,k) & \cong \Hom _Q(\Hom _Q(\mathcal {S}_Q,Q),k) &\text {by definition of $\Gamma $} \\ & \cong \Hom _Q(\Hom _Q(\mathcal {S}_Q,Q),Q) \otimes _Q k \\ & \cong \mathcal {S}_Q \otimes _Q k \\ & \cong \mathcal {S}_k. \end {aligned}\end {equation*}
endstream
endobj
25444 0 obj
<< /Type /Filespec /AFRelationship /Source /Desc (TeX source) /F (tag-AFfile4649.tex) /UF <FEFF007400610067002D0041004600660069006C00650034003600340039002E007400650078> /EF<</F 25443 0 R/UF 25443 0 R>> >>
endobj
25448 0 obj
<< /Subtype /application#2Fx-tex/Type /EmbeddedFile /Params<</ModDate (D:20260730) >> /Length 701 >>        
stream
\begin {equation*}\begin {aligned} \Hom _E(E \otimes _Q \Gamma \otimes _Q F, k) & \cong \Hom _Q(\Gamma \otimes _Q F, \Hom _E(E, k)) & \text {by Hom-tensor adjunction} \\ & \cong \Hom _Q(\Gamma \otimes _Q F, k) \\ & \cong \Hom _Q(F, \Hom _Q(\Gamma ,k)) & \text {by Hom-tensor adjunction} \\ & \cong \Hom _Q(F, \mathcal {S}_k) & \text {by the calculation above} \\ & \cong \Hom _Q(F,Q) \otimes _Q \mathcal {S}_k & \text {by \Cref {hom exercise for ES}} \\ & \cong \Hom _Q(F,Q) \otimes _Q k \otimes _Q \mathcal {S}_k & \text {since } k \otimes _Q \mathcal {S}_k \otimes _Q \mathcal {S}_k\\ & \cong \Hom _Q(F,k) \cong \mathcal {S}_k & \text {by \Cref {hom exercise for ES}.} \end {aligned}\end {equation*}
endstream
endobj
