stream
\begin {equation*}\sigma _{\mathbf {0}} = \partial _F \qquad \qquad \sigma _{{\mathbf {e}}_i} \sigma _{\mathbf {0}} + \sigma _{\mathbf {0}} \sigma _{{\mathbf {e}}_i} = f_i \cdot \id _F \qquad \qquad \sum _{u+v = \omega } \sigma _u \sigma _v = 0 \quad \text { for all } |\omega | \geqslant 2.\end {equation*}
endstream
endobj
